<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="TeacherSite.master.cs" Inherits="Codercept.TeacherSite" %>
<%@ Register Src="~/TeacherSideBar.ascx" TagPrefix="uc" TagName="TeacherSideBar" %>

<!DOCTYPE html>
<html lang="en">
<head id="tpHead" runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Teacher Portal - Codercept</title>

    <!-- Prototype fonts (Inter / Plus Jakarta Sans / JetBrains Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />

    <!-- 1. Shared variables + layout, 2. Teacher portal styles (must load AFTER global.css) -->
    <link href="~/css/global.css" rel="stylesheet" type="text/css" />
    <link id="lnkTeacherCss" runat="server" href="~/css/teacher-portal.css" rel="stylesheet" type="text/css" />

    <asp:ContentPlaceHolder ID="cphHead" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="formTeacher" runat="server">
        <div class="dashboard-layout tp-app">

            <button type="button" class="sidebar-backdrop" aria-label="Close navigation" data-tp-backdrop data-tp-close-menu></button>
            <uc:TeacherSideBar ID="TeacherSideBarCtrl" runat="server" />

            <main class="main-content">
                <header class="mobile-header">
                    <button type="button" class="icon-button mobile-menu" aria-label="Open menu" data-tp-open-menu>
                        <%= TeacherIcons.Svg("menu", 20) %>
                    </button>
                    <div class="mobile-brand">
                        <img src="img/Codercept_Icon.png" alt="" style="height: 32px; width: auto;" />
                        <span class="brand-name">Codercept</span>
                    </div>
                    <a href="TeacherAccount.aspx" aria-label="Open My Account">
                        <span class="avatar avatar--indigo avatar--sm" aria-hidden="true"><%= UserInitial %></span>
                    </a>
                </header>

                <div class="page-container">
                    <asp:ContentPlaceHolder ID="cphMain" runat="server"></asp:ContentPlaceHolder>
                </div>
            </main>

            <div class="toast" role="status" data-tp-toast>
                <span class="toast-icon"><%= TeacherIcons.Svg("check", 15) %></span>
                <span data-tp-toast-text></span>
            </div>

            <% if (TeacherAiSettings.IsReady) { %>
            <%-- Floating assistant: questions go to TeacherAiHandler.ashx (feature "chat"); the answers are shown as plain text --%>
            <div class="tp-chat" data-tp-chat>
                <section class="tp-chat-panel" id="tpChatPanel" role="dialog" aria-label="Codercept assistant" data-tp-chat-panel hidden>
                    <header class="tp-chat-head">
                        <div>
                            <strong>Codercept assistant</strong>
                            <span>Ask how the Teacher Portal works</span>
                        </div>
                        <button type="button" class="tp-chat-clear" data-tp-chat-clear>New chat</button>
                        <button type="button" class="icon-button" aria-label="Close assistant" data-tp-chat-close><%= TeacherIcons.Svg("x", 16) %></button>
                    </header>
                    <div class="tp-chat-log" role="log" aria-live="polite" data-tp-chat-log></div>
                    <div class="tp-chat-form">
                        <textarea rows="2" maxlength="1000" placeholder="Ask a question..." aria-label="Your question" data-tp-chat-input></textarea>
                        <button type="button" class="tp-chat-send" aria-label="Send question" data-tp-chat-send><%= TeacherIcons.Svg("send", 17) %></button>
                    </div>
                    <p class="tp-chat-note">The assistant can make mistakes. Do not share passwords or personal details.</p>
                </section>
                <button type="button" class="tp-chat-launch" aria-label="Open the assistant" aria-expanded="false" aria-controls="tpChatPanel" data-tp-chat-launch><%= TeacherIcons.Svg("message", 22) %></button>
            </div>
            <% } %>

            <!-- Page-specific modals live inside .tp-app so the scoped styles apply -->
            <asp:ContentPlaceHolder ID="cphModals" runat="server"></asp:ContentPlaceHolder>
        </div>
    </form>

    <script src="<%= ResolveUrl("~/TeacherPortal.js") %>?v=<%= AssetVersion("~/TeacherPortal.js") %>"></script>
    <asp:ContentPlaceHolder ID="cphScripts" runat="server"></asp:ContentPlaceHolder>
</body>
</html>
